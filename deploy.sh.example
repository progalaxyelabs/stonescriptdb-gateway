#!/bin/bash
# =============================================================================
# StoneScriptDB Gateway Deployment Script
# =============================================================================
# Deploys the gateway binary to the VM and restarts the service.
# Copy to deploy.sh and configure SSH hosts for your environment.
#
# Usage:
#   ./deploy.sh [TARGET]
#
# Targets:
#   dev   - Deploy to development server (default)
#   prod  - Deploy to production server
# =============================================================================

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# =============================================================================
# CONFIGURE THESE FOR YOUR ENVIRONMENT
# =============================================================================
# SSH host aliases (must be in ~/.ssh/config or resolvable hostnames)
DEV_SSH_HOST="your-dev-server"      # e.g. devvm, localhost
PROD_SSH_HOST="your-prod-server"    # e.g. gateway-vm, gateway.example.com

# Set to true if the remote host requires sudo to manage the systemd service
DEV_USE_SUDO=false
PROD_USE_SUDO=true
# =============================================================================

TARGET_ARG=${1:-dev}

# Binary source: prefer Docker-built output/ (GLIBC-compatible), fallback to cargo target/
if [ -f "output/stonescriptdb-gateway" ]; then
    BINARY_SOURCE="output/stonescriptdb-gateway"
elif [ -f "target/release/stonescriptdb-gateway" ]; then
    BINARY_SOURCE="target/release/stonescriptdb-gateway"
    echo -e "${YELLOW}Warning: Using locally compiled binary (target/release/).${NC}"
    echo -e "${YELLOW}This may fail on prod due to GLIBC mismatch. Run ./build.sh first.${NC}"
else
    echo -e "${RED}Error: No binary found. Run ./build.sh first.${NC}"
    exit 1
fi

case "$TARGET_ARG" in
    prod)
        SSH_HOST="$PROD_SSH_HOST"
        USE_SUDO=$PROD_USE_SUDO
        ;;
    dev)
        SSH_HOST="$DEV_SSH_HOST"
        USE_SUDO=$DEV_USE_SUDO
        ;;
    *)
        SSH_HOST="$TARGET_ARG"
        USE_SUDO=true
        ;;
esac

echo -e "${YELLOW}Deploying to: ${SSH_HOST} (binary: ${BINARY_SOURCE})${NC}"

# Copy binary to VM
echo -e "${YELLOW}Copying binary...${NC}"
scp "$BINARY_SOURCE" "${SSH_HOST}:/tmp/stonescriptdb-gateway"

# Deploy on VM
echo -e "${YELLOW}Deploying...${NC}"
if [ "$USE_SUDO" = true ]; then
    ssh "$SSH_HOST" << 'ENDSSH'
set -e
echo "Stopping service..."
sudo systemctl stop stonescriptdb-gateway
echo "Installing binary..."
sudo mv /tmp/stonescriptdb-gateway /opt/stonescriptdb-gateway/stonescriptdb-gateway
sudo chmod +x /opt/stonescriptdb-gateway/stonescriptdb-gateway
sudo chown stonescriptdb-gateway:stonescriptdb-gateway /opt/stonescriptdb-gateway/stonescriptdb-gateway
echo "Starting service..."
sudo systemctl start stonescriptdb-gateway
sleep 3
sudo systemctl status stonescriptdb-gateway --no-pager -l | head -20
curl -sf http://localhost:9000/health && echo "Health check: OK" || echo "Health check: FAILED"
ENDSSH
else
    # No-sudo variant: process must restart via systemd (RestartSec=5)
    ssh "$SSH_HOST" << 'ENDSSH'
set -e
echo "Replacing binary (systemd will auto-restart)..."
kill $(pgrep -f stonescriptdb-gateway) 2>/dev/null || true
mv /tmp/stonescriptdb-gateway /opt/stonescriptdb-gateway/stonescriptdb-gateway
chmod +x /opt/stonescriptdb-gateway/stonescriptdb-gateway
sleep 6
curl -sf http://localhost:9000/health && echo "Health check: OK" || echo "Health check: FAILED"
ENDSSH
fi

echo ""
echo -e "${GREEN}=== Deployment Successful ===${NC}"
echo "Service is running on ${SSH_HOST}"
echo "To view logs: ssh ${SSH_HOST} 'sudo journalctl -u stonescriptdb-gateway -f'"
