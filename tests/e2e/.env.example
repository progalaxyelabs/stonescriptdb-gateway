# Gateway Configuration
GATEWAY_URL=http://localhost:9000

# Test Platform Configurations
# Set these to the platform codes and tenant slugs you want to test with
APP1_PLATFORM_CODE=myapp
APP1_TENANT_SLUG=test-tenant

APP2_PLATFORM_CODE=otherapp
APP2_TENANT_SLUG=test-company

# OAuth Test Credentials (optional - for Google OAuth tests)
GOOGLE_TEST_EMAIL=
GOOGLE_TEST_PASSWORD=

# Test User Credentials
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=TestPass123!

# Admin Test Credentials
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=AdminPass123!

# Database Connection (for fixture setup)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gateway
DB_USER=gateway
DB_PASSWORD=gateway123
